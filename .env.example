# Everything here is optional. With no .env, Comply runs fully offline.

# fixture (default): canned answers, no keys, no network.
# live: Ask the radar uses a key below. Triage stays on fixtures.
LLM_MODE=fixture

# Used only when LLM_MODE=live. Anthropic is preferred if both are set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# simulated (default): a labeled fake run that stops at the approval gate.
# manual: shows a copy-ready task packet; you set the status by hand.
PARTNER_MODE=simulated

# Shown on the About page. Without it the card says NOT YET.
GROKBOT_DEMO_VIDEO_URL=

# Advanced, not needed for the demo.
# LLM_TRIAGE=1 also sends triage to the model when LLM_MODE=live.
# RADAR_SOURCES=live fetches real sources in npm run radar:run.
# NEXT_PUBLIC_CARTO_API_KEY turns on CARTO Dark Matter map tiles.
