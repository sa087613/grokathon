# All optional. With nothing set, Peachtree runs in FIXTURE mode.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# anthropic | openai. Defaults to whichever key is present (Anthropic first).
LLM_PROVIDER=
# Set to 1 to force fixture mode even when keys are present.
LLM_FIXTURE=
# Optional model overrides.
LLM_MODEL_CHEAP=
LLM_MODEL_FULL=
# fixture (default) reads /fixtures. live fetches the real sources.
RADAR_SOURCES=fixture
# Optional. Turns on CARTO Dark Matter map tiles.
NEXT_PUBLIC_CARTO_API_KEY=
